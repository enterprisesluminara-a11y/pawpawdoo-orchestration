<section class="hero-section" id="hero">
  <div class="container hero-grid">
    
    <!-- Left: Gallery -->
    <div class="gallery-wrapper">
      <div class="main-image-container">
        <span class="badge-overlay-top-left">🔥 68% Pick Multi-Pack</span>
        <span class="badge-overlay-top-right">🛡️ 30-Night Guarantee</span>
        <img 
          id="mainHeroImage" 
          class="main-hero-img" 
          src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=1000&q=80" 
          alt="PawPawDoo Orthopedic Calming Cloud Dog Bed"
        >
      </div>

      <div class="thumbnails-row">
        <div class="thumb-item active" data-full-src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=1000&q=80">
          <img src="https://images.unsplash.com/photo-1541599540903-216a46ca1dc0?auto=format&fit=crop&w=200&q=80" alt="Cloud Bed">
        </div>
        <div class="thumb-item" data-full-src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=1000&q=80">
          <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?auto=format&fit=crop&w=200&q=80" alt="Puppy Sleeping">
        </div>
        <div class="thumb-item" data-full-src="https://images.unsplash.com/photo-1537151608828-ea2b11777ee8?auto=format&fit=crop&w=1000&q=80">
          <img src="https://images.unsplash.com/photo-1537151608828-ea2b11777ee8?auto=format&fit=crop&w=200&q=80" alt="Bolster Rim">
        </div>
        <div class="thumb-item" data-full-src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1000&q=80">
          <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=200&q=80" alt="Orthopedic Memory Foam">
        </div>
      </div>
    </div>

    <!-- Right: Offer Content -->
    <div class="hero-content">
      
      <div class="rating-social-row">
        <span class="stars">★★★★★</span>
        <span class="rating-score">4.9 / 5.0</span>
        <span class="reviews-count">(14,820+ Verified Dog Parents)</span>
      </div>

      <h1 class="hero-headline">Give Your Furry Best Friend The Cloud Sleep They Deserve — Because It's <span style="color: var(--color-terracotta);">Pawmily first.</span></h1>
      
      <p class="hero-subheadline">
        Engineered with human-grade orthopedic memory foam and anxiety-melting faux fur bolsters to soothe joints and ease stress within 5 minutes.
      </p>

      <div class="logistics-banner-card">
        <div class="icon">🚀</div>
        <div class="text">
          <strong>Fast Local Dispatch:</strong> Ships in 3–5 Days from US Warehouse (Tracked USPS Priority).
        </div>
      </div>

      <ul class="value-props-list">
        <li><span class="check-icon">✓</span> <span><strong>Veterinarian Approved:</strong> Relieves hip dysplasia & joint stiffness.</span></li>
        <li><span class="check-icon">✓</span> <span><strong>Instant Anxiety Relief:</strong> 360° raised rim simulates mother's embrace.</span></li>
        <li><span class="check-icon">✓</span> <span><strong>100% Machine Washable:</strong> Removable zippered waterproof lining.</span></li>
        <li><span class="check-icon">✓</span> <span><strong>Non-Slip Grip Base:</strong> Safely anchored on hardwood floors.</span></li>
      </ul>

      <!-- Bundle Box -->
      <div class="offer-box-container">
        <div class="offer-box-header">
          <span class="offer-box-title">Select Your Bundle & Save:</span>
          <span class="live-viewers-pill">⚡ 48 viewing</span>
        </div>

        <div class="bundle-options-list">
          <div class="bundle-card" data-tier="1">
            <div class="bundle-radio"></div>
            <div class="bundle-details">
              <h4>1x Cloud Dog Bed</h4>
              <p>Standard Pack for Single Room</p>
            </div>
            <div class="bundle-pricing">
              <div class="bundle-price-main">$78.95</div>
              <div class="bundle-price-compare">$102.64</div>
            </div>
          </div>

          <div class="bundle-card selected" data-tier="2">
            <span class="bundle-badge-ribbon popular">68% CHOOSE THIS — BEST VALUE</span>
            <div class="bundle-radio"></div>
            <div class="bundle-details">
              <h4>2x Multi-Room Pack (Living Room + Bedroom)</h4>
              <p><span class="bundle-bonus-tag">+ Free Odor-Eliminating Paw Care Guide</span></p>
            </div>
            <div class="bundle-pricing">
              <div class="bundle-price-main">$134.22</div>
              <div class="bundle-price-compare">$205.28</div>
              <div style="font-size: 11px; color: var(--color-terracotta); font-weight: 700;">SAVE 15%</div>
            </div>
          </div>

          <div class="bundle-card" data-tier="3">
            <span class="bundle-badge-ribbon">MAXIMUM SAVINGS</span>
            <div class="bundle-radio"></div>
            <div class="bundle-details">
              <h4>3x Ultimate Fur-Family Pack (Multi-Pet)</h4>
              <p><span class="bundle-bonus-tag">+ Free Spare Cover & Grooming Glove</span></p>
            </div>
            <div class="bundle-pricing">
              <div class="bundle-price-main">$185.53</div>
              <div class="bundle-price-compare">$307.92</div>
              <div style="font-size: 11px; color: var(--color-terracotta); font-weight: 700;">SAVE 22%</div>
            </div>
          </div>
        </div>

        <div class="cta-button-container">
          <button class="btn-primary-cta trigger-checkout" id="mainCtaButton">
            <span id="mainCtaText">Claim Your Multi-Room Pack — $134.22 (Save 35%)</span>
            <span>➔</span>
          </button>
          
          <div class="guarantee-micro-note">
            <span>🛡️ 30-Night Risk-Free Trial</span>
            <span>•</span>
            <span>📦 Free Express Shipping</span>
            <span>•</span>
            <span>🔒 SSL 256-Bit Encrypted</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": []
}
{% endschema %}
