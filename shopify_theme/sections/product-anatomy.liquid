<section class="anatomy-section" id="anatomy">
  <div class="container">
    <div class="section-header">
      <div class="section-tag">Veterinarian-Engineered</div>
      <h2 class="section-title">Anatomy of the Ultimate Calming Cloud Bed</h2>
      <p class="section-desc">Every layer is scientifically designed to reduce cortisol (stress hormone) levels and relieve pressure points.</p>
    </div>

    <div class="anatomy-grid">
      <div>
        <img 
          style="border-radius: 22px; box-shadow: 0 6px 20px rgba(55,40,29,0.08); border: 1px solid #EADBCE;" 
          src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1000&q=80" 
          alt="Cloud Bed Memory Foam Anatomy"
        >
      </div>

      <div class="anatomy-layers-list">
        
        <div class="layer-card">
          <div class="layer-number">Layer 01</div>
          <h3 class="layer-title">Ultra-Plush Faux Fur Bolster Rim</h3>
          <p class="layer-desc">Mimics a mother dog's soothing coat warmth, triggering psychological safety and easing separation anxiety.</p>
        </div>

        <div class="layer-card">
          <div class="layer-number">Layer 02</div>
          <h3 class="layer-title">Waterproof Odor-Shield Inner Liner</h3>
          <p class="layer-desc">Protects the core foam from slobber, moisture accidents, and dander. Removable via hidden anti-chew zipper.</p>
        </div>

        <div class="layer-card">
          <div class="layer-number">Layer 03</div>
          <h3 class="layer-title">Medical-Grade Orthopedic Memory Foam</h3>
          <p class="layer-desc">Contours to your pet's body, absorbing joint pressure and promoting healthy spinal alignment.</p>
        </div>

        <div class="layer-card">
          <div class="layer-number">Layer 04</div>
          <h3 class="layer-title">Heavy-Duty Non-Skid Silicone Grip Base</h3>
          <p class="layer-desc">Keeps the bed safely anchored even during zoomies or excited bounding.</p>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Anatomy",
  "settings": []
}
{% endschema %}

