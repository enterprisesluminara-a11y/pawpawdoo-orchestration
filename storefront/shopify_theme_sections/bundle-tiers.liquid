{% comment %}
  PawPawDoo - High-Converting Multi-Pack Bundle Tiers
  Theme 2.0 Compatible Liquid Section (Rule #4 CRO compliant)
{% endcomment %}

<section class="pawpawdoo-bundles-section section-{{ section.id }}" id="bundle-tiers" style="padding: 64px 0; background: #FFFFFF;">
  <div class="page-width" style="max-width: 900px; margin: 0 auto; text-align: center;">
    
    <span style="color: #C86432; font-weight: 800; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1px;">LIMITED TIME FLASH SALE</span>
    <h2 style="color: #37281D; font-size: 2.2rem; font-weight: 800; margin: 8px 0 16px;">Select Your Multi-Pack & Save</h2>
    <p style="color: #5E4A3E; font-size: 1.1rem; margin-bottom: 36px;">Most pet parents get the 2-pack for the living room and bedroom.</p>

    <div class="bundle-grid" style="display: flex; flex-direction: column; gap: 16px; text-align: left;">
      
      <!-- Tier 1 -->
      <div class="bundle-tier-card" style="border: 2px solid #EADBCE; border-radius: 12px; padding: 20px; background: #FAF8F5; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h4 style="margin: 0 0 4px; color: #37281D; font-size: 1.2rem;">1x Cloud Dog Bed</h4>
          <p style="margin: 0; color: #5E4A3E; font-size: 0.9rem;">Standard Pack for Single Room</p>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 1.3rem; font-weight: 800; color: #37281D;">$78.95</span>
          <div style="font-size: 0.85rem; color: #999; text-decoration: line-through;">$102.64</div>
        </div>
      </div>

      <!-- Tier 2 (Most Popular) -->
      <div class="bundle-tier-card popular" style="border: 2px solid #C86432; border-radius: 12px; padding: 20px; background: #FFFDFB; box-shadow: 0 8px 24px rgba(200, 100, 50, 0.15); position: relative; display: flex; justify-content: space-between; align-items: center;">
        <span style="position: absolute; top: -12px; right: 24px; background: #C86432; color: #fff; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">BEST VALUE — 68% OF CUSTOMERS CHOOSE THIS</span>
        <div>
          <h4 style="margin: 0 0 4px; color: #37281D; font-size: 1.2rem;">2x Multi-Room Pack (Living Room + Bedroom)</h4>
          <p style="margin: 0; color: #C86432; font-weight: 700; font-size: 0.9rem;">+ Free Odor-Eliminating Paw Care Guide</p>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 1.4rem; font-weight: 800; color: #37281D;">$134.22</span>
          <div style="font-size: 0.85rem; color: #C86432; font-weight: 700;">SAVE 15%</div>
        </div>
      </div>

      <!-- Tier 3 -->
      <div class="bundle-tier-card" style="border: 2px solid #EADBCE; border-radius: 12px; padding: 20px; background: #FAF8F5; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <h4 style="margin: 0 0 4px; color: #37281D; font-size: 1.2rem;">3x Ultimate Fur-Family Pack (Multi-Pet)</h4>
          <p style="margin: 0; color: #C86432; font-weight: 700; font-size: 0.9rem;">+ Free Spare Waterproof Cover & Grooming Glove</p>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 1.3rem; font-weight: 800; color: #37281D;">$185.53</span>
          <div style="font-size: 0.85rem; color: #C86432; font-weight: 700;">SAVE 22%</div>
        </div>
      </div>

    </div>

    <div style="margin-top: 32px;">
      <a href="/cart/15345170022445:2" class="button" style="background: #C86432; color: #fff; width: 100%; max-width: 500px; padding: 18px 24px; font-size: 1.2rem; font-weight: 800; border-radius: 10px; text-decoration: none; display: inline-block; box-shadow: 0 8px 24px rgba(200, 100, 50, 0.35);">
        Claim 2-Pack Multi-Room Bundle (Save 15%) ➔
      </a>
      <p style="font-size: 0.85rem; color: #5E4A3E; margin-top: 10px;">🛡️ 30-Night Risk-Free Trial • 📦 Free 3–5 Day US Delivery</p>
    </div>

  </div>
</section>

