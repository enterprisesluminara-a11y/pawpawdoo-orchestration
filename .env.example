# ==============================================================================
# PawPawDoo Multi-Agent Architecture Environment Variables
# Copy this file to .env and fill in your credentials for local or cloud runs.
# ==============================================================================

# Core AI Engines
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# System Guardrails
PAWPAWDOO_ENV=DRAFT  # DRAFT or PRODUCTION (Rule #3 compliance)

# Shopify Admin API Integration
SHOPIFY_STORE_URL=pawpawdoo.store
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_access_token
SHOPIFY_API_VERSION=2024-10
